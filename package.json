{
  "name": "aura-music-player",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube Music Streaming Player Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "test:backend": "npm --workspace=backend test",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "node scripts/build.cjs"
  },
  "dependencies": {
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.0"
  }
}
